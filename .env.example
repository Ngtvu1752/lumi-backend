# ============================================
# LUMI Backend - Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# --- PostgreSQL + TimescaleDB ---
POSTGRES_USER=lumi
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lumi
DATABASE_URL=postgresql+asyncpg://lumi:change_me@timescaledb:5432/lumi
TIMESCALEDB_URL=postgresql://lumi:change_me@timescaledb:5432/lumi

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT Security ---
JWT_SECRET_KEY=generate-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Algorithm Constants ---
TAU_R=18.2
TAU_D=4.2
A_C=0.1333
SLEEP_DEBT_WINDOW=14
SLEEP_DEBT_WARNING_THRESHOLD=300.0
CIRCADIAN_PERIOD=24.2

# --- App ---
PROJECT_NAME=LUMI Backend
API_V1_PREFIX=/api/v1
ENERGY_CACHE_TTL=86400

FCM_CREDENTIALS_PATH=config/firebase-service-account.json
